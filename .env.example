# Copy to backend/.env and fill in real values
PORT=5000

# --- PostgreSQL ---
# Option A: one connection string (used if set; good for Render/hosted DBs)
# DATABASE_URL=postgresql://user:password@host:5432/dbname
# PGSSL=true            # set when the host requires SSL (most cloud providers)

# Option B: discrete vars (used when DATABASE_URL is not set)
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=admin
PGDATABASE=Capstone

# --- Auth ---
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d

# --- Seeded admin account ---
ADMIN_NAME=Site Admin
ADMIN_EMAIL=admin@demo.com
ADMIN_PASSWORD=Admin123!

# --- CORS ---
CLIENT_ORIGIN=*
